# 复制本文件为 .env，并填入你的真实 API Key
# 推荐 DeepSeek：https://platform.deepseek.com

DEEPSEEK_API_KEY=sk-在这里填入你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 若改用其他 OpenAI 兼容平台，替换以上三项即可，例如：
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------
# 安全与成本限额（都有默认值，一般不用改；按需放开注释调整）
# ---------------------------------------------------------------
# 单次提问最大字符数
# AGENT_MAX_QUESTION_CHARS=2000
# 生成代码的语法节点上限（挡异常超长代码）
# AGENT_MAX_CODE_NODES=4000
# pandas 代码执行超时（秒）
# AGENT_EXEC_TIMEOUT=20
# 单条 SQL 执行超时（秒）
# AGENT_SQL_TIMEOUT=10
# 结果集行数上限（超出截断）
# AGENT_MAX_RESULT_ROWS=20000
# 网页会话提问次数上限（0 = 不限制）
# AGENT_MAX_QUESTIONS=50
# 运行日志目录（默认 output/logs）
# AGENT_LOG_DIR=output/logs
# 命令行会话保存目录（默认 ~/.data-agent；chat -c 续聊读取这里）
# AGENT_HOME=~/.data-agent
